//! Polars expression plugins.

use polars::prelude::*;
use pyo3_polars::derive::polars_expr;

/// Greet each name in a string column.
#[polars_expr(output_type=String)]
fn greet_expr(inputs: &[Series]) -> PolarsResult<Series> {
    let names = inputs[0].str()?;
    let out: StringChunked = names.try_apply_into_string_amortized(|name, output| {
        // Polars reports the library's error as a `ComputeError`
        let result = {{package_name}}::greet(name);
        let greeting = result.map_err(|error| polars_err!(ComputeError: "{error}"))?;
        output.push_str(&greeting);
        PolarsResult::Ok(())
    })?;
    Ok(out.into_series())
}
